+#define AEGIS_PROBE_BEGIN(chrom, okflag) ::aegis::perf::EvalProbe aegis_probe_((chrom), (okflag))
+#define AEGIS_PROBE_MARK(stage) aegis_probe_.mark(::aegis::perf::stage)
+#else
+#define AEGIS_PROBE_BEGIN(chrom, okflag) ((void)0)
